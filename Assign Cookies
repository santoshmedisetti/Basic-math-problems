class Solution:
    def findContentChildren(self, g: List[int], s: List[int]) -> int:
        g.sort()
        s.sort()
        i=0
        j=0
        while i<len(g) and j<len(s):
            if s[j]>=g[i]:
                i+=1 #child is satisfied
            j+=1 #Move to  next cookies
        return i
