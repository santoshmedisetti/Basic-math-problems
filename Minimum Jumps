class Solution:
    def minJumps(self, arr):
        n = len(arr)
        
        # If array has only one element
        if n == 1:
            return 0
        
        # If first element is 0, we can't move
        if arr[0] == 0:
            return -1
        
        jumps = 0
        maxReach = 0
        currentEnd = 0
        
        for i in range(n - 1):
            maxReach = max(maxReach, i + arr[i])
            
            # If we reached end of current jump range
            if i == currentEnd:
                jumps += 1
                currentEnd = maxReach
                
                # If we cannot move further
                if currentEnd <= i:
                    return -1
                
                # If we can reach end
                if currentEnd >= n - 1:
                    return jumps
        
        return -1
